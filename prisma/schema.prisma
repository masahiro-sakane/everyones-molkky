// みんなのモルック - Prismaスキーマ

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ユーザー
model User {
  id            String    @id @default(cuid())
  name          String
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teamMembers   TeamMember[]
  throws        Throw[]
  accounts      Account[]
  createdMatches Match[]
  createdTeams   Team[]

  @@map("users")
}

// NextAuth - OAuthアカウント連携
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth - メール認証トークン（将来用）
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// チーム
model Team {
  id              String   @id @default(cuid())
  name            String
  isSolo          Boolean  @default(false)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy  User?       @relation(fields: [createdByUserId], references: [id])
  members    TeamMember[]
  matchTeams MatchTeam[]

  @@map("teams")
}

// チームメンバー（中間テーブル）
model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

// 試合
model Match {
  id                String      @id @default(cuid())
  status            MatchStatus @default(WAITING)
  shareCode         String      @unique @default(cuid())
  matchType         MatchType   @default(TEAM)
  limitType         LimitType   @default(NONE)
  turnLimit         Int?
  timeLimitMinutes  Int?
  totalSets         Int         @default(1)
  startedAt         DateTime?
  createdByUserId   String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  createdBy  User?       @relation(fields: [createdByUserId], references: [id])
  matchTeams MatchTeam[]
  sets       Set[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("matches")
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

enum MatchType {
  TEAM
  SOLO
}

enum LimitType {
  NONE
  TURNS
  TIME
}

// 試合参加チーム
model MatchTeam {
  id          String   @id @default(cuid())
  matchId     String
  teamId      String
  order       Int
  memberOrder String[]

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([matchId, teamId])
  @@unique([matchId, order])
  @@map("match_teams")
}

// セット（1試合に複数セット対応）
model Set {
  id        String    @id @default(cuid())
  matchId   String
  setNumber Int
  status    SetStatus @default(IN_PROGRESS)
  winnerId  String?

  match          Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  turns          Turn[]
  teamSetScores  TeamSetScore[]

  @@unique([matchId, setNumber])
  @@index([matchId, status])
  @@map("sets")
}

enum SetStatus {
  IN_PROGRESS
  FINISHED
}

// ターン（チームの投擲ラウンド）
model Turn {
  id         String @id @default(cuid())
  setId      String
  turnNumber Int

  set    Set     @relation(fields: [setId], references: [id], onDelete: Cascade)
  throws Throw[]

  @@unique([setId, turnNumber])
  @@map("turns")
}

// 投擲（1回の投げ）
model Throw {
  id              String     @id @default(cuid())
  turnId          String
  userId          String
  teamId          String
  throwOrder      Int
  skittlesKnocked Int[]
  score           Int
  isFault         Boolean    @default(false)
  faultType       FaultType?
  createdAt       DateTime   @default(now())

  turn Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([turnId, throwOrder])
  @@index([teamId])
  @@map("throws")
}

enum FaultType {
  MISS
  DROP
  STEP_OVER
  WRONG_ORDER
}

// チーム別セットスコア（集計用）
model TeamSetScore {
  id                String  @id @default(cuid())
  setId             String
  teamId            String
  totalScore        Int     @default(0)
  consecutiveMisses Int     @default(0)
  isDisqualified    Boolean @default(false)

  set Set @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, teamId])
  @@map("team_set_scores")
}
